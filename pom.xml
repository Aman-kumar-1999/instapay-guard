<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>
    <groupId>com.instapay</groupId>
    <artifactId>instapay-guard</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>instapay-guard</name>

    <properties>
        <java.version>17</java.version>
        <sonar.projectKey>instapay-guard</sonar.projectKey>
        <sonar.projectName>InstaPay Guard Platform</sonar.projectName>
        <sonar.host.url>http://localhost:9000</sonar.host.url>
        <sonar.java.compliance>17</sonar.java.compliance>
    </properties>

    <modules>
        <module>payment-gateway-service</module>
        <module>fraud-analytics-service</module>
        <module>ledger-notification-service</module>
    </modules>
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.sonarsource.scanner.maven</groupId>
                    <artifactId>sonar-maven-plugin</artifactId>
                    <version>3.10.0.2594</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>